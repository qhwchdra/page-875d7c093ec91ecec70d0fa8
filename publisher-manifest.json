ent h1 {font-size: 3.1rem}\n            .plans-grid {grid-template-columns: 1fr}\n            .hero-info {max-width: 100%;margin: 0 0 1.5rem}\n        }\n    </style><header>\n        <div class=\"header-content\">\n            <div class=\"logo\">FastPass</div>\n            <div class=\"breadcrumb\">\n                <a href=\"#\">首页</a> / <a href=\"#\">服务</a> / <a href=\"#\">选择方案</a>\n            </div>\n        </div>\n    </header>\n\n    <section class=\"hero\">\n        <div class=\"hero-content\">\n            <h1>FastPass</h1>\n            <p class=\"tagline\">通过问答式引导找到最适合您的流量方案</p>\n            <div class=\"hero-info\">\n                <p>奶油黄与墨绿调色设计，简洁明了的导航与服务详情，专为高效上网而生。</p>\n                <div class=\"quick-links\">\n                    <a href=\"#plans\">立即查看方案</a>\n                    <a href=\"#faq\">常见问题</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"section\" id=\"plans\">\n        <h2>流量方案</h2>\n        <div class=\"plans-grid\">\n            \n            <div class=\"plan-card\">\n                <div class=\"num\">01</div>\n                <h3>基础版</h3>\n                <div class=\"price\">¥15<span>/月</span></div>\n                <div class=\"annual\">按年付仅需 ¥150/年</div>\n                <ul>\n                    <li>每月 100GB 极速流量</li>\n                    <li>支持 3 台设备同时在线</li>\n                    <li>解锁基础流媒体</li>\n                    <li>普通线路节点池</li>\n                </ul>\n            </div>\n            \n            \n            <div class=\"plan-card\">\n                <div class=\"num\">02</div>\n                <h3>旗舰版</h3>\n                <div class=\"price\">¥35<span>/月</span></div>\n                <div class=\"annual\">按年付仅需 ¥350/年</div>\n                <div>推荐</div>\n                <ul>\n                    <li>每月 300GB 极速流量</li>\n                    <li>支持 5 台设备同时在线</li>\n                    <li>全节点原生流媒体解锁</li>\n                    <li>IPLC 专线游戏加速优化</li>\n                    <li>7x24 优先工单支持</li>\n                </ul>\n            </div>\n            \n            \n            <div class=\"plan-card\">\n                <div class=\"num\">03</div>\n                <h3>团队版</h3>\n                <div class=\"price\">¥85<span>/月</span></div>\n                <div class=\"annual\">按年付仅需 ¥850/年</div>\n                <ul>\n                    <li>每月 1000GB 极速流量</li>\n                    <li>支持 20 台设备同时在线</li>\n                    <li>VIP 专属高带宽节点</li>\n                    <li>支持企业定制路由</li>\n                    <li>专属客户经理服务</li>\n                </ul>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"section faq-section\" id=\"faq\">\n        <h2>常见问题</h2>\n        <div class=\"faq-content\">\n            \n            <details class=\"faq-item\">\n                <summary>我该如何选择适合自己的流量方案？</summary>\n                <div class=\"faq-answer\">\n                    <p>根据您的设备数量、需要解锁的流媒体类型以及预算来决定。基础版适合个人单人使用，旗舰版则提供更全面的加速支持，而团队版适合多人共同使用或企业环境。建议根据当前流量需求先选择旗舰版试用。</p>\n                </div>\n            </details>\n            \n            \n            <details class=\"faq-item\">\n                <summary>年付方案比月付划算吗？</summary>\n                <div class=\"faq-answer\">\n                    <p>是的，按年付能显著降低每月成本。例如基础版年付只需 ¥150，比12个月 ¥180 节省 ¥30。所有方案均支持年付模式，具体以页面显示的年付价格为准。</p>\n                </div>\n            </details>\n            \n            \n            <details class=\"faq-item\">\n                <summary>如何使用设备连接？</summary>\n                <div class=\"faq-answer\">\n                    <p>下载对应客户端后，输入您的账号信息即可连接。旗舰版支持 5 台设备同时在线，团队版更适合多用户环境。连接后可通过仪表盘实时查看流量使用情况。</p>\n                </div>\n            </details>\n            \n            \n            <details class=\"faq-item\">\n                <summary>流媒体解锁是否包含所有平台？</summary>\n                <div class=\"faq-answer\">\n                    <p>基础版支持基础解锁，旗舰版提供全节点原生流媒体解锁，覆盖主流视频和音频平台。团队版在 VIP 高带宽节点基础上同样提供完整解锁能力。</p>\n                </div>\n            </details>\n            \n            \n            <details class=\"faq-item\">\n                <summary>客服支持时间和方式是什么？</summary>\n                <div class=\"faq-answer\">\n                    <p>旗舰版和团队版均提供 7x24 优先工单服务。基础版则提供标准工单响应时间。所有客服均通过平台内消息或专用电话支持。</p>\n                </div>\n            </details>\n        </div>\n    </section>\n\n    <footer class=\"footer\">\n        <div>\n            <div class=\"logo\">FastPass</div>\n            <p>通过问答式引导找到最适合您的流量方案</p>\n            <p>© 2026 FastPass • 专为高效上网设计 • 所有方案已写入正文</p>\n        </div>\n    </footer></main>",
